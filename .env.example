# Postgres (@see docker-compose.yml)
DATABASE_URL=postgres://leopold:leopold@localhost:5432/leopold
POSTGRES_PASSWORD=leopold

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Ollama (Embeddings)
OLLAMA_BASE_URL=http://localhost:11434

# LLM-Provider
ANTHROPIC_API_KEY=

# Adzuna Job-Search-API (obtain free App-ID/Key from https://developer.adzuna.com/signup)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Deployment (docker-compose.yml + Caddy, @see .github/workflows/deploy.yml)
IMAGE_TAG=latest
APP_DOMAIN=
APP_PORT=3000
HETZNER_API_TOKEN=
