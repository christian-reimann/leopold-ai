{
  "name": "leopold",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres redis ollama",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "build": "next build && esbuild src/worker/runner.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/worker/runner.mjs",
    "start": "next start",
    "worker": "node --env-file=.env dist/worker/runner.mjs",
    "worker:dev": "tsx watch --env-file=.env src/worker/runner.ts",
    "connectors:test": "tsx --env-file=.env scripts/test-connectors.ts",
    "match-thresholds:analyze": "tsx --env-file=.env scripts/analyze-match-thresholds.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --coverage --project unit --project integration"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.21",
    "@ai-sdk/react": "^4.0.45",
    "@napi-rs/canvas": "^1.0.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "ai": "^7.0.37",
    "bullmq": "^5.81.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.27.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.12",
    "postgres": "^3.4.9",
    "puppeteer": "^25.4.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^12.1.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.11"
  }
